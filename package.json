{
  "name": "cors-browser",
  "displayName": "Open Browser Preview",
  "description": "🚀 Preview HTML file in your default browser or in-editor Webview panel",
  "version": "2.0.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "icon": "assets/icon.png",
  "author": {
    "name": "Eno Yao",
    "email": "kalone.cool@gmail.com",
    "url": "https://github.com/Wscats"
  },
  "publisher": "Wscats",
  "categories": [
    "Other",
    "Debuggers"
  ],
  "galleryBanner": {
    "color": "#58bc58",
    "theme": "dark"
  },
  "keywords": [
    "preview",
    "view",
    "open",
    "html",
    "browser",
    "chrome",
    "webview",
    "live-reload"
  ],
  "homepage": "https://github.com/Wscats/browser-preview",
  "bugs": {
    "url": "https://github.com/Wscats/browser-preview/issues/new"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Wscats/browser-preview"
  },
  "activationEvents": [
    "onLanguage:html",
    "onCommand:browserPreview.openInBrowser",
    "onCommand:browserPreview.openInWebview"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "browserPreview.openInBrowser",
        "title": "Preview: Open in Default Browser",
        "icon": "$(browser)"
      },
      {
        "command": "browserPreview.openInWebview",
        "title": "Preview: Open in Editor Webview",
        "icon": "$(open-preview)"
      }
    ],
    "keybindings": [
      {
        "command": "browserPreview.openInBrowser",
        "key": "ctrl+f1",
        "mac": "cmd+f1",
        "when": "editorTextFocus && resourceLangId == html"
      },
      {
        "command": "browserPreview.openInWebview",
        "key": "ctrl+shift+f1",
        "mac": "cmd+shift+f1",
        "when": "editorTextFocus && resourceLangId == html"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "when": "resourceLangId == html",
          "command": "browserPreview.openInBrowser",
          "group": "browserPreview@1"
        },
        {
          "when": "resourceLangId == html",
          "command": "browserPreview.openInWebview",
          "group": "browserPreview@2"
        }
      ],
      "editor/context": [
        {
          "when": "resourceLangId == html",
          "command": "browserPreview.openInBrowser",
          "group": "browserPreview@1"
        },
        {
          "when": "resourceLangId == html",
          "command": "browserPreview.openInWebview",
          "group": "browserPreview@2"
        }
      ],
      "editor/title": [
        {
          "when": "resourceLangId == html",
          "command": "browserPreview.openInWebview",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Browser Preview",
      "properties": {
        "browserPreview.defaultBrowser": {
          "type": "string",
          "default": "default",
          "enum": ["default", "chrome", "firefox", "safari", "edge"],
          "description": "The browser to use when opening files externally."
        },
        "browserPreview.port": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 65535,
          "description": "Local server port for serving HTML files. 0 = auto-assign."
        },
        "browserPreview.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Automatically refresh the Webview panel when the file is saved."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "bundle": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --minify",
    "bundle:dev": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "lint": "eslint src --ext .ts",
    "test": "node ./out/test/runTest.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vscode/test-electron": "^2.3.8",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.20.0",
    "eslint": "^9.0.0",
    "mocha": "^10.3.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "open": "^10.1.0"
  }
}